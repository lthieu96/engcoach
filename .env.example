# Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# No LLM key here — each user configures their own provider in Settings → AI provider.
# Required only for Settings → "Sync to account": encrypts the synced provider
# config at rest. Any long random string (e.g. `openssl rand -hex 32`).
# LLM_SYNC_SECRET=
# Optional: override the default model name used when the picker leaves it blank.
# LLM_MODEL=gemini-3.5-flash
